        <mxCell id="hardware" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9EEF4;strokeColor=#64748B;strokeWidth=2;fontSize=14;fontColor=#183153;align=center;verticalAlign=middle;spacing=10;dashed=1;" value="&lt;b&gt;ROCKYBORG HARDWARE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PiBorg reference:&lt;/b&gt;&lt;br&gt;Two rear geared DC drive motors&lt;br&gt;Front wheel steered by chassis-tilting servo&lt;br&gt;Purpose-made motor controller&lt;br&gt;&lt;br&gt;&lt;b&gt;Team hardware list:&lt;/b&gt;&lt;br&gt;Raspberry Pi 4, 8 GB&lt;br&gt;Camera Module 3 (view tilts with chassis)&lt;br&gt;Light sensor, laser distance sensor, BME280&lt;br&gt;&lt;br&gt;&lt;b&gt;Check actual kit revision, installed parts, and stock.&lt;/b&gt;" vertex="1">
